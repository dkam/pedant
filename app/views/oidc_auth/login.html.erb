<% content_for :title, "Sign in · Pedant" %>

<div class="mx-auto max-w-sm">
  <h1 class="text-2xl font-semibold">Sign in</h1>

  <% case SignInMethod.current %>
  <% when :password %>
    <%= form_with url: login_path, class: "mt-6 space-y-5" do |form| %>
      <div>
        <%= form.label :email, "Email", class: "label" %>
        <%= form.email_field :email, value: params[:email], required: true, autofocus: true, autocomplete: "username", class: "field" %>
      </div>
      <div>
        <%= form.label :password, "Password", class: "label" %>
        <%= form.password_field :password, required: true, autocomplete: "current-password", class: "field" %>
      </div>
      <%= form.submit "Sign in", class: "btn" %>
    <% end %>
  <% when :oidc %>
    <p class="mt-2 text-sm text-stone-600">Pedant signs you in through your identity provider.</p>
    <%= link_to "Sign in with #{OidcProvider.current.name}", login_start_path, class: "btn mt-6", data: { turbo: false } %>
  <% else %>
    <p class="mt-2 text-sm text-stone-600">
      Pedant isn't set up yet. The setup code is printed on the server's console.
    </p>
    <%= link_to "Set up Pedant", setup_path, class: "btn mt-6" %>
  <% end %>
</div>
