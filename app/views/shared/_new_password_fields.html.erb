<div>
  <%= form.label :password, label, class: "label" %>
  <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: User::PASSWORD_LENGTH.max, class: "field" %>
  <p class="hint">At least <%= User::PASSWORD_LENGTH.min %> characters.</p>
</div>

<div>
  <%= form.label :password_confirmation, "Confirm password", class: "label" %>
  <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: User::PASSWORD_LENGTH.max, class: "field" %>
</div>
