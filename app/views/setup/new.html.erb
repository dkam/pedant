<% content_for :title, "Set up Pedant" %>

<div class="mx-auto max-w-md">
  <h1 class="text-2xl font-semibold">Set up Pedant</h1>
  <p class="mt-2 text-sm text-stone-600">
    Enter the code printed on the server's console, then your OIDC provider's
    details. Pedant sends you to the provider to sign in, and the account you
    sign in with becomes the owner.
  </p>

  <div class="mt-6 rounded-md border border-stone-200 bg-white px-4 py-3 text-sm">
    <p class="text-stone-600">Register this redirect URI with the provider:</p>
    <code class="mt-1 block break-all font-mono text-stone-900"><%= auth_callback_url %></code>
    <p class="mt-2 text-stone-600">For backchannel logout, if the provider offers it:</p>
    <code class="mt-1 block break-all font-mono text-stone-900"><%= oidc_logout_url %></code>
  </div>

  <%= form_with model: @provider, url: setup_path, method: :post, class: "mt-8 space-y-5" do |form| %>
    <% if @provider.errors.any? %>
      <div class="alert">
        <ul class="list-disc space-y-1 pl-4">
          <% @provider.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= label_tag :code, "Setup code", class: "label" %>
      <%= text_field_tag :code, nil, required: true, autofocus: true, autocomplete: "off",
            spellcheck: false, autocapitalize: "characters", class: "field font-mono uppercase tracking-widest" %>
      <p class="hint">Twelve characters in three groups. Case and dashes don't matter.</p>
    </div>

    <div>
      <%= form.label :issuer, "Issuer URL", class: "label" %>
      <%= form.url_field :issuer, required: true, placeholder: "https://auth.example.com", class: "field" %>
      <p class="hint">Pedant fetches its discovery document before saving.</p>
    </div>

    <div>
      <%= form.label :client_id, "Client ID", class: "label" %>
      <%= form.text_field :client_id, required: true, autocomplete: "off", class: "field" %>
    </div>

    <div>
      <%= form.label :client_secret, "Client secret", class: "label" %>
      <%= form.password_field :client_secret, value: nil, required: !@provider.persisted?, autocomplete: "off", class: "field" %>
      <p class="hint">
        <% if @provider.persisted? %>
          A secret is saved. Leave this blank to keep it.
        <% else %>
          Stored encrypted, and never shown again.
        <% end %>
      </p>
    </div>

    <div>
      <%= form.label :name, "Provider name", class: "label" %>
      <%= form.text_field :name, required: true, class: "field" %>
      <p class="hint">Shown on the sign-in button.</p>
    </div>

    <%= form.submit "Save and sign in", class: "btn" %>
  <% end %>
</div>
