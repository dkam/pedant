<% content_for :title, "Set up Pedant" %>

<div class="mx-auto max-w-md">
  <h1 class="text-2xl font-semibold">Set up Pedant</h1>
  <p class="mt-2 text-sm text-stone-600">
    Enter the code printed on the server's console, and choose how you'll sign
    in: a password, or your OIDC provider. Only the one you choose will work.
    You can switch from a password to OIDC later in settings.
  </p>

  <section class="mt-8 rounded-lg border border-stone-200 bg-white p-6">
    <h2 class="text-lg font-semibold">With a password</h2>
    <p class="mt-1 text-sm text-stone-600">One owner account, nothing else to run.</p>

    <%= form_with model: @owner, url: setup_password_path, method: :post, class: "mt-5 space-y-5" do |form| %>
      <%= render "shared/errors", record: @owner %>
      <%= render "setup/code_field", id: "password_code" %>
      <div>
        <%= form.label :email, "Email", class: "label" %>
        <%= form.email_field :email, required: true, autocomplete: "username", class: "field" %>
        <p class="hint">What you'll sign in with.</p>
      </div>
      <%= render "shared/new_password_fields", form: form, label: "Password" %>
      <%= form.submit "Set password and sign in", class: "btn" %>
    <% end %>
  </section>

  <section class="mt-6 rounded-lg border border-stone-200 bg-white p-6">
    <h2 class="text-lg font-semibold">With OIDC</h2>
    <p class="mt-1 text-sm text-stone-600">
      Pedant sends you to the provider to sign in, and that account becomes the owner.
    </p>

    <%= form_with model: @provider, url: setup_path, method: :post, class: "mt-5 space-y-5" do |form| %>
      <%= render "shared/errors", record: @provider %>
      <%= render "setup/code_field", id: "oidc_code" %>
      <%= render "shared/provider_fields", form: form, provider: @provider %>
      <%= form.submit "Save and sign in", class: "btn" %>
    <% end %>
  </section>
</div>
