<% content_for :title, "Settings · Pedant" %>

<div class="mx-auto max-w-md">
  <h1 class="text-2xl font-semibold">Settings</h1>

  <% if SignInMethod.password? && current_user.password_digest.present? %>
    <section class="mt-8 rounded-lg border border-stone-200 bg-white p-6">
      <h2 class="text-lg font-semibold">Change password</h2>
      <p class="mt-1 text-sm text-stone-600">Every other session is signed out.</p>

      <%= form_with model: current_user, url: settings_password_path, method: :patch, class: "mt-5 space-y-5" do |form| %>
        <%= render "shared/errors", record: current_user %>
        <%= render "settings/current_password_field", id: "password_current_password" %>
        <%= render "shared/new_password_fields", form: form, label: "New password" %>
        <%= form.submit "Change password", class: "btn" %>
      <% end %>
    </section>

    <section class="mt-6 rounded-lg border border-stone-200 bg-white p-6">
      <h2 class="text-lg font-semibold">Switch to OIDC</h2>
      <p class="mt-1 text-sm text-stone-600">
        Pedant sends you to the provider to sign in, and links that account to
        this one. Your password is then removed, and only OIDC works. Until
        you finish signing in there, the password keeps working.
      </p>

      <%= form_with model: @provider, url: settings_oidc_path, method: :post, class: "mt-5 space-y-5" do |form| %>
        <%= render "shared/errors", record: @provider %>
        <%= render "settings/current_password_field", id: "oidc_current_password" %>
        <%= render "shared/provider_fields", form: form, provider: @provider %>
        <%= form.submit "Save and sign in", class: "btn" %>
      <% end %>
    </section>
  <% else %>
    <section class="mt-8 rounded-lg border border-stone-200 bg-white p-6 text-sm">
      <h2 class="text-lg font-semibold">Sign-in</h2>
      <p class="mt-2 text-stone-600">
        You sign in with <%= OidcProvider.current&.name || "OIDC" %>. To switch back to a password, run
        <code class="font-mono">bin/rails pedant:reset_oidc</code> on the server and choose a password at setup.
      </p>
    </section>
  <% end %>
</div>
