<% content_for :title, "Settings · Pedant" %>

<h1 class="text-2xl font-semibold">Settings</h1>

<%# Each section is a .settings-section: what it is on the left, its card on
    the right, stacked on a phone. Inside a card, fields pair up when the card
    is wide enough (@lg, a container query), not when the window is. %>
<div class="mt-6">
  <% if SignInMethod.password? && current_user.password_digest.present? %>
    <% email_user = @email_user || current_user %>
    <section id="email" data-section="email" class="settings-section">
      <div>
        <h2 class="text-lg font-semibold">Email</h2>
        <p class="mt-1 text-sm text-soft">What you sign in with.</p>
      </div>

      <%= form_with model: email_user, url: settings_email_path, method: :patch,
            class: "@container space-y-5 rounded-lg border border-rule bg-surface p-4 sm:p-6" do |form| %>
        <%= render "shared/errors", record: email_user %>
        <div class="grid gap-5 @lg:grid-cols-2">
          <div>
            <%= form.label :email, "Email", class: "label" %>
            <%= form.email_field :email, required: true, autocomplete: "username", class: "field" %>
          </div>
          <%= render "settings/current_password_field", id: "email_current_password" %>
        </div>
        <%= form.submit "Change email", class: "btn" %>
      <% end %>
    </section>

    <% password_user = @password_user || current_user %>
    <section id="password" data-section="password" class="settings-section">
      <div>
        <h2 class="text-lg font-semibold">Password</h2>
        <p class="mt-1 text-sm text-soft">Changing it signs out every other session.</p>
      </div>

      <%= form_with model: password_user, url: settings_password_path, method: :patch,
            class: "@container space-y-5 rounded-lg border border-rule bg-surface p-4 sm:p-6" do |form| %>
        <%= render "shared/errors", record: password_user %>
        <div class="grid gap-5 @lg:grid-cols-2">
          <%= render "settings/current_password_field", id: "password_current_password" %>
        </div>
        <div class="grid gap-5 @lg:grid-cols-2">
          <%= render "shared/new_password_fields", form: form, label: "New password" %>
        </div>
        <%= form.submit "Change password", class: "btn" %>
      <% end %>
    </section>

    <section id="oidc" data-section="oidc" class="settings-section">
      <div>
        <h2 class="text-lg font-semibold">Switch to OIDC</h2>
        <p class="mt-1 text-sm text-soft">
          Pedant sends you to the provider to sign in, and links that account to
          this one. Your password is then removed, and only OIDC works.
        </p>
        <p class="mt-2 text-sm text-soft">Until you finish signing in there, the password keeps working.</p>
      </div>

      <%= form_with model: @provider, url: settings_oidc_path, method: :post,
            class: "@container space-y-5 rounded-lg border border-rule bg-surface p-4 sm:p-6" do |form| %>
        <%= render "shared/errors", record: @provider %>
        <div class="grid gap-5 @lg:grid-cols-2">
          <%= render "settings/current_password_field", id: "oidc_current_password" %>
        </div>
        <%= render "shared/provider_fields", form: form, provider: @provider %>
        <%= form.submit "Save and sign in", class: "btn" %>
      <% end %>
    </section>
  <% else %>
    <section id="sign-in" data-section="sign-in" class="settings-section">
      <div>
        <h2 class="text-lg font-semibold">Sign-in</h2>
        <p class="mt-1 text-sm text-soft">How you get into Pedant.</p>
      </div>

      <div class="rounded-lg border border-rule bg-surface p-4 text-sm sm:p-6">
        <p class="text-soft">
          You sign in with <%= OidcProvider.current&.name || "OIDC" %>. To switch back to a password, run
          <code class="font-mono">bin/rails pedant:reset_oidc</code> on the server and choose a password at setup.
        </p>
      </div>
    </section>
  <% end %>

  <%= render "settings/api_tokens" %>

  <%# A failed save re-renders this page; show that source as it was submitted, with its errors. %>
  <% source_readout = Readout::Sources.new %>
  <%= render "sources/sources", readout: source_readout,
        sources: source_readout.sources.map { |source| source.id == @source&.id ? @source : source },
        new_source: (@source if @source&.new_record?) || Source.new %>
</div>
