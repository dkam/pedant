<% content_for :title, "#{@monitor.name} · Pedant" %>
<%= turbo_stream_from :monitors %>

<div class="flex items-center gap-3">
  <h1 class="text-2xl font-semibold"><%= @monitor.name %></h1>
  <%= render "monitors/state", state: @monitor.retired? ? "retired" : @monitor.state %>
</div>
<p class="mt-1 font-mono text-sm text-stone-600"><%= @monitor.target %></p>

<dl class="mt-6 grid grid-cols-2 gap-4 rounded-lg border border-stone-200 bg-white p-6 text-sm sm:grid-cols-4">
  <div><dt class="text-stone-500">Since</dt><dd><%= @monitor.state_changed_at ? time_ago_in_words(@monitor.state_changed_at) : "–" %></dd></div>
  <div><dt class="text-stone-500">Down in 24h / 7d</dt><dd><%= @monitor.flaps %> / <%= @monitor.flaps(within: 7.days) %></dd></div>
  <div><dt class="text-stone-500">Every</dt><dd><%= @monitor.interval %>s, <%= @monitor.timeout %>s timeout, <%= pluralize(@monitor.retries, "retry") %></dd></div>
  <div><dt class="text-stone-500">Defined in</dt><dd class="font-mono"><%= @monitor.source.name %>: <%= @monitor.defined_in %></dd></div>
</dl>

<div class="mt-8 grid gap-8 md:grid-cols-2">
  <section>
    <h2 class="text-lg font-semibold">State changes</h2>
    <ul class="mt-3 divide-y divide-stone-100 rounded-lg border border-stone-200 bg-white text-sm">
      <% @state_changes.each do |change| %>
        <li data-state-change class="px-4 py-2">
          <%= render "monitors/state", state: change.to_state %>
          <span class="text-stone-600"><%= time_ago_in_words(change.changed_at) %> ago</span>
          <% if change.message.present? %><div class="text-xs text-stone-500"><%= change.message %></div><% end %>
        </li>
      <% end %>
      <% if @state_changes.none? %><li class="px-4 py-2 text-stone-500">None yet.</li><% end %>
    </ul>
  </section>

  <section>
    <h2 class="text-lg font-semibold">Recent checks</h2>
    <ul class="mt-3 divide-y divide-stone-100 rounded-lg border border-stone-200 bg-white text-sm">
      <% @checks.each do |check| %>
        <li data-check class="flex items-center justify-between gap-3 px-4 py-2">
          <span><%= render "monitors/state", state: check.status %> <span class="text-xs text-stone-500"><%= check.message %></span></span>
          <span class="whitespace-nowrap text-xs text-stone-500">
            <%= "#{check.latency_ms} ms · " if check.latency_ms %><%= time_ago_in_words(check.checked_at) %> ago
          </span>
        </li>
      <% end %>
      <% if @checks.none? %><li class="px-4 py-2 text-stone-500">None yet.</li><% end %>
    </ul>
  </section>
</div>
