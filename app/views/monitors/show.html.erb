<% content_for :title, "#{@monitor.name} · Pedant" %>
<%= turbo_stream_from :monitors %>

<div class="flex items-center gap-3">
  <h1 class="text-2xl font-semibold"><%= @monitor.name %></h1>
  <%= render "monitors/state", state: @monitor.retired? ? "retired" : @monitor.state %>
</div>
<p class="mt-1 text-sm text-soft <%= "font-mono" unless @monitor.push? %>"><%= monitor_target(@monitor) %></p>

<dl class="mt-6 grid grid-cols-2 gap-4 rounded-lg border border-rule bg-surface p-6 text-sm sm:grid-cols-4">
  <div><dt class="text-faint">Since</dt><dd><%= @monitor.state_changed_at ? time_ago_in_words(@monitor.state_changed_at) : "–" %></dd></div>
  <div><dt class="text-faint">Down in 24h / 7d</dt><dd><%= @monitor.flaps %> / <%= @monitor.flaps(within: 7.days) %></dd></div>
  <% if @monitor.push? %>
    <% if @monitor.scheduled? %>
      <div><dt class="text-faint">Expected</dt><dd class="font-mono text-xs"><%= @monitor.schedule_in_words %></dd><dd>plus <%= seconds_in_words(@monitor.grace) %> grace</dd></div>
    <% else %>
      <div><dt class="text-faint">Missed after</dt><dd><%= seconds_in_words(@monitor.interval + @monitor.grace) %> of silence</dd></div>
    <% end %>
  <% else %>
    <div><dt class="text-faint">Every</dt><dd><%= @monitor.interval %>s, <%= @monitor.timeout %>s timeout, <%= pluralize(@monitor.retries, "retry") %></dd></div>
  <% end %>
  <% if @monitor.push? && @monitor.forecast? %>
    <div data-forecast><dt class="text-faint">Forecast</dt><dd><%= @monitor.forecast_in_words %></dd></div>
  <% end %>
  <div><dt class="text-faint">Defined in</dt><dd class="font-mono"><%= @monitor.source.name %>: <%= @monitor.defined_in %></dd></div>
</dl>

<% if @monitor.state == "down" && @monitor.outage_started_at && !@monitor.retired? %>
  <section data-hide class="mt-6 rounded-lg border border-rule bg-surface p-6 text-sm">
    <% if @monitor.hidden? %>
      <p>Hidden <%= hidden_in_words(@monitor) %>. No reminders until then, and recovering ends it. If it's still down then, a reminder goes out straight away.</p>
      <%= button_to "Show it again", monitor_hide_path(@monitor), method: :delete, class: "btn mt-3" %>
    <% else %>
      <h2 class="font-semibold">Hide this outage</h2>
      <p class="mt-1 text-soft">
        If you know why it's down, hide it: no reminders, and it moves out of the way on the dashboard. Recovering ends it,
        and if it's still down when the hide ends, a reminder goes out straight away. To silence it for good, change monitors.yml.
      </p>
      <div class="mt-3 flex flex-wrap gap-2">
        <% if @monitor.push? %>
          <%= button_to "Until its next run", monitor_hide_path(@monitor), params: { until: "next_run" }, class: "btn",
                title: "Until its next push, or until #{@monitor.next_check_at&.utc&.strftime("%-d %b %H:%M UTC")} if none comes" %>
        <% end %>
        <%= button_to "For 24 hours", monitor_hide_path(@monitor), params: { until: "day" }, class: "btn" %>
      </div>
    <% end %>
  </section>
<% end %>

<% if @monitor.push? %>
  <section class="mt-6 rounded-lg border border-rule bg-surface p-6 text-sm">
    <h2 class="font-semibold">Pushing to it</h2>
    <p class="mt-1 text-soft">
      End the job with a request to this URL. Pedant keeps only the token's digest, so the token is
      wherever the job's secrets are (<code class="font-mono">bin/rails pedant:push_token</code> makes a new one).
    </p>
    <pre class="mt-3 overflow-x-auto rounded bg-well p-3 font-mono text-xs">curl -fsS "<%= request.base_url %>/api/push/&lt;token&gt;?status=up&amp;msg=OK"</pre>
    <p class="mt-2 text-soft"><code class="font-mono">status=down</code> marks it down straight away; <code class="font-mono">msg</code> and <code class="font-mono">ping</code> are kept with the check.
      <% if @monitor.value_settings.any? %><code class="font-mono">value=</code> is judged against the limits in monitors.yml.<% end %>
      <code class="font-mono">status=start</code> at the start of a run records how long it takes<%= @monitor.max_runtime ? ", and marks it down if it runs past #{seconds_in_words(@monitor.max_runtime)}" : "" %>.</p>
    <p class="mt-2 text-soft" data-push-sources>Pushes are taken only from <%= push_sources_in_words(@monitor) %>; from anywhere else, the token is refused as unknown (<code class="font-mono">from:</code> in monitors.yml).</p>
    <% if @monitor.started_at %><p class="mt-2 text-warn">Running since <%= time_ago_in_words(@monitor.started_at) %> ago.</p><% end %>
  </section>
<% end %>

<div class="mt-6 grid gap-4 md:grid-cols-2">
  <% if @monitor.push? %>
    <% value = @monitor.value_settings %>
    <% if value.any? %>
      <%= line_chart @chart_checks.map(&:value), kind: "value",
            title: [ value["label"].presence || "Value", ("(#{value["unit"]})" if value["unit"].present?) ].compact.join(" "),
            limits: value.slice("warn_above", "warn_below").values.map { |limit| [ limit, "warn" ] } +
                    value.slice("down_above", "down_below").values.map { |limit| [ limit, "down" ] },
            format: ->(number) { @monitor.format_value(number) } %>
    <% end %>
    <%= duration_chart @chart_checks.map(&:duration_ms) %>
  <% else %>
    <%= line_chart @chart_checks.map(&:latency_ms), kind: "latency", title: "Latency (ms)", format: ->(number) { "#{number} ms" } %>
  <% end %>
</div>

<div class="mt-8 grid gap-8 md:grid-cols-2">
  <section>
    <h2 class="text-lg font-semibold">State changes</h2>
    <ul class="mt-3 divide-y divide-rule-faint rounded-lg border border-rule bg-surface text-sm">
      <% @state_changes.each do |change| %>
        <li data-state-change class="px-4 py-2">
          <%= render "monitors/state", state: change.to_state %>
          <span class="text-soft"><%= time_ago_in_words(change.changed_at) %> ago</span>
          <% if change.message.present? %><div class="text-xs text-faint"><%= change.message %></div><% end %>
        </li>
      <% end %>
      <% if @state_changes.none? %><li class="px-4 py-2 text-faint">None yet.</li><% end %>
    </ul>
  </section>

  <section>
    <h2 class="text-lg font-semibold">Recent checks</h2>
    <ul class="mt-3 divide-y divide-rule-faint rounded-lg border border-rule bg-surface text-sm">
      <% @checks.each do |check| %>
        <li data-check class="flex items-center justify-between gap-3 px-4 py-2">
          <span><%= render "monitors/state", state: check.status %> <span class="text-xs text-faint"><%= check.message %></span></span>
          <span class="whitespace-nowrap text-xs text-faint">
            <%= "#{check.latency_ms} ms · " if check.latency_ms %><%= time_ago_in_words(check.checked_at) %> ago
          </span>
        </li>
      <% end %>
      <% if @checks.none? %><li class="px-4 py-2 text-faint">None yet.</li><% end %>
    </ul>
  </section>
</div>
